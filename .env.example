# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Temporary bootstrap token. Set only during the first-admin setup, then remove it from Vercel.
ADMIN_SETUP_TOKEN=

# Server-only URL. Set this or the legacy NEXT_PUBLIC_SUPABASE_URL alias, not both.
SUPABASE_URL=
# Legacy URL alias for existing deployments; no Supabase URL is exposed to browser code by this app.
# NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Prefer the new Supabase secret key. Never expose a key in NEXT_PUBLIC_* or browser code.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT is still supported when SUPABASE_SECRET_KEY is not set.
# SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Control Generadores <no-reply@your-verified-domain.example>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development-only explicit fallback. Keep both false/unset in production.
ALLOW_DEMO_DATA=false
ALLOW_DEMO_EMAIL=false
